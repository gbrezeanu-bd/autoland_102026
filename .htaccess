# Added by Gabriela Brezeanu on Aug 21 2026
# --- Block direct access to sensitive file types ---
<FilesMatch "(?i)\.(sql|sql\.gz|bak|old|backup|log|inc|env|ini|sh|swp|tmp|xls|xlsx|xlsm)$">
  Require all denied
</FilesMatch>
# Belt-and-braces for exact/legacy names and Apache < 2.4:
<Files "error_log">
  Require all denied
</Files>
RewriteRule (?i)\.(sql|bak|old|backup|log)(\.gz)?$ - [F,L]

# Specify which files to serve for directory requests - added by Gabriela Brezeanu on Oct 30 2025
DirectoryIndex index.php index.html

# Force redirect to HTTPS
RewriteEngine on
RewriteCond %{HTTPS} !=on
RewriteRule ^.*$ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

# 3 Nov 2025 added by Gabriela Brezeanu
# Redirect mobile subdomain to main domain (m.domain.com → domain.com)
# Handles both m.autolandromania.ro and www.m.autolandromania.ro
RewriteCond %{HTTP_HOST} ^(www\.)?m\.autolandromania\.ro$ [NC]
RewriteRule ^(.*)$ https://autolandromania.ro/$1 [R=301,L]

# Redirect www to non-www (301 permanent redirect for SEO)
# This ensures https://www.autolandromania.ro redirects to https://autolandromania.ro
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Canonicalize sitemap filename to lowercase
# Redirect /Sitemap.xml (and other case variants) to /sitemap.xml
RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
RewriteRule ^sitemap\.xml$ /sitemap.xml [R=301,L,NC]

# EXCEPTII - Fișiere care trebuie accesate direct (trebuie să fie înainte de regulile generice)
RewriteCond %{REQUEST_URI} ^/sitemap-generator\.php$ [NC]
RewriteRule ^ - [L]

# 21 Oct 2025 added by Gabriela Brezeanu
# Fix malformed pagination URLs: redirect /page.php&page=X to /page.php?page=X
RewriteCond %{REQUEST_URI} ^(/[^?&]+\.php)&(.+)$
RewriteRule ^(.*)$ %1?%2 [R=301,L]

# Redirect malformed URL with includes path to main listings page
RewriteRule ^vanzari_detail\.php/includes/form_interesatde_mail_processor\.php$ /vanzari.php [R=301,L]
RewriteRule ^([^/]+\.php)/includes/form_mail_processor\.php$ /contact.php [R=301,L]
RewriteRule ^([^/]+\.php)/includes/form_interesatde_mail_processor\.php$ /vanzari.php [R=301,L]

# Fix malformed URLs: Redirect paths like /vanzari_detail.php/lista_oferta.php to proper pages
RewriteRule ^vanzari_detail\.php/lista_oferta\.php$ /lista_oferta.php [R=301,L]
RewriteRule ^([^/]+\.php)/([^/]+\.php)$ /$2 [R=301,L]

# Fix missing jQuery validate file reference
RewriteRule ^jquery\.validate$ /themes/automotive/js/jquery.validate.min.js [R=301,L]
# end

# ========================================
# URL REWRITING RULES - ORDINEA CONTEAZĂ!
# ========================================
# IMPORTANT: Regulile mai SPECIFICE trebuie SUS, regulile GENERICE jos!

# ----------------------------------------
# REGULI PENTRU ARTICOLE (Mai Specifice)
# ----------------------------------------
# Articolele trebuie să aibă pattern mai specific pentru a nu conflicta

# /articole (fără slug) → articole.php (pagina de listare)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^articole/?$ articole.php [L,QSA]

# /articole/ghid-masini-second-hand → articol.php?slug=ghid-masini-second-hand
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^articole/([a-zA-Z0-9\-_]+)$ articol.php?slug=$1 [L,QSA]

# ----------------------------------------
# PAGINI DE CONȚINUT DIN TABELUL `pagini` (editabile din admin)
# ----------------------------------------
# /finantare/credit-auto → /finantare/credit-auto/ (un singur URL, cu slash)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(finantare|garantie)/([a-z0-9\-]+)$ %{REQUEST_URI}/ [R=301,L]

# /finantare/credit-auto/ → pagina.php?sectiune=finantare&slug=credit-auto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(finantare|garantie)/([a-z0-9\-]+)/$ pagina.php?sectiune=$1&slug=$2 [L,QSA]

# Pagini la rădăcină (secțiunea "pagini"), ex. /buy-back/ → pagina.php?sectiune=pagini&slug=buy-back
# Lista se completează când se adaugă o pagină nouă la rădăcină.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(buy-back|masini-la-comanda|despre-noi|livrare-in-toata-tara)$ %{REQUEST_URI}/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(buy-back|masini-la-comanda|despre-noi|livrare-in-toata-tara)/$ pagina.php?sectiune=pagini&slug=$1 [L,QSA]

# 19 Dec 2024 added as recommended by sucuri https://docs.sucuri.net/warnings/hardening/security-headers-x-frame-options/
Header always append X-Frame-Options SAMEORIGIN

# 19 Dec 2024 added as recommended by sucuri https://docs.sucuri.net/warnings/hardening/security-headers-x-content-type-nosniff/
Header set X-Content-Type-Options nosniff

# 19 Dec 2024 added as recommended by sucuri in https://blog.sucuri.net/2023/12/what-is-content-security-policy.html
