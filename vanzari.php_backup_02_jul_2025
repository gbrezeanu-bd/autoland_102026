      array_push($newParams, $param);
    }
  }
  if (count($newParams) != 0) 
  {
    $queryString_vanzare = "&amp;" . htmlentities(implode("&", $newParams));
  }
}
$queryString_vanzare = sprintf("&amp;totalRows_vanzare=%d%s", $totalRows_vanzare, $queryString_vanzare);
      
