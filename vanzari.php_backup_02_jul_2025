$col_combustibil_vanzare = "%";
if (isset($_GET['combustibil'])) {
  $col_combustibil_vanzare = (get_magic_quotes_gpc()) ? $_GET['combustibil'] : addslashes($_GET['combustibil']);
}             
$col_prov_enienta_vanzare = "%";
if (isset($_GET['prov_enienta'])) {
	$col_prov_enienta_vanzare = (get_magic_quotes_gpc()) ? $_GET['prov_enienta'] : addslashes($_GET['prov_enienta']);
}

if(isset($_GET['txtsrc']) && (!empty($_GET['txtsrc'])))
{
	if (!strcmp("#S10", substr($_GET['txtsrc'], 0, 4)))
		{	
			$textt = substr($_GET['txtsrc'], 4, 10);
			$query_vanzare 	= 'SELECT * FROM masini WHERE stare_anunt LIKE 1 AND id LIKE '.$textt.' ORDER BY pret';
		}
	else 
	{
	$textt = $_GET['txtsrc'];
	$words = explode(' ',$textt);
	$words = array_slice($words, 0, 2);
	$fields = array('marca', 'tip');
	$whereText = array();
	foreach ($words as $word) {
		$whereSubText = array();
		foreach ($fields as $field) {
			$whereSubText[] = ' ('.$field.' LIKE "%'.$word.'%") ';
		}
		$whereText[] = '('. join(' OR ', $whereSubText) .')';
	}
	$whereText = '('. join(' AND ',$whereText) .')';
	if (!strcmp("fara", $col_prov_enienta_vanzare))
		{ $whereprov_enienta = ""; }
	else
		{ 
		$whereprov_enienta = $col_prov_enienta_vanzare == '%' ?  '':' (prov_enienta=\''.$col_prov_enienta_vanzare.'\') AND '; 
		}
	$query_vanzare 	= 'SELECT * FROM masini WHERE stare_anunt LIKE 1 AND '.$whereprov_enienta.' '.$whereText.' ORDER BY pret';
	}
}
else
{
	// Check if we have an exact marca match or need to use LIKE with wildcard
	// Create the proper marca condition directly in the query to avoid sprintf issues with complex strings
	if ($col_marca_vanzare == "%") {
		$marca_condition = "marca LIKE '%'";
	} else {
		$marca_condition = "marca LIKE '" . $col_marca_vanzare . "'";
	}
	
	if ((!strcmp("fara", $col_combustibil_vanzare)) && (!strcmp("fara",$col_prov_enienta_vanzare)))
	{ $query_vanzare = sprintf("SELECT * FROM masini WHERE stare_anunt LIKE 1 AND an>=%s AND pret<=%s AND %s ORDER BY pret ASC", 
		$col_an_vanzare, $col_pret_vanzare, $marca_condition); }
	elseif (!strcmp("fara", $col_combustibil_vanzare))
	{ $query_vanzare = sprintf("SELECT * FROM masini WHERE stare_anunt LIKE 1 AND an>=%s AND pret<=%s AND %s AND prov_enienta LIKE '%s' ORDER BY pret ASC", 
		$col_an_vanzare, $col_pret_vanzare, $marca_condition, $col_prov_enienta_vanzare); }
	elseif (!strcmp("fara",$col_prov_enienta_vanzare))
	{ $query_vanzare = sprintf("SELECT * FROM masini WHERE stare_anunt LIKE 1 AND an>=%s AND pret<=%s AND combustibil LIKE '%s' AND %s ORDER BY pret ASC", 
		$col_an_vanzare, $col_pret_vanzare, $col_combustibil_vanzare, $marca_condition); }
	else
	{ $query_vanzare = sprintf("SELECT * FROM masini WHERE stare_anunt LIKE 1 AND an>=%s AND pret<=%s AND combustibil LIKE '%s' AND %s AND prov_enienta LIKE '%s' ORDER BY pret ASC", 
		$col_an_vanzare, $col_pret_vanzare, $col_combustibil_vanzare, $marca_condition, $col_prov_enienta_vanzare); }
}

$query_limit_vanzare 	= sprintf("%s LIMIT %d, %d", $query_vanzare, $startRow_vanzare, $maxRows_vanzare);
$vanzare 		= $connection->query($query_limit_vanzare) or die($connection->error);
